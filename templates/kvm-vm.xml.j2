<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
    <name>{{ controlNodes.hosts[0].vm_name }}</name>
    <memory unit='MiB'>{{ controlNodes.hosts[0].vm_memory }}</memory>
    <vcpu placement='static'>{{ controlNodes.hosts[0].vm_cpu }}</vcpu>
    <os>
        <type arch='x86_64' machine='q35'>hvm</type> <boot dev='cdrom'/>
        <boot dev='hd'/>
    </os>
    <features>
        <acpi/>
        <apic/>
    </features>
    <cpu mode='host-passthrough'/>
    <clock offset='utc'/>
    <on_poweroff>destroy</on_poweroff>
    <on_reboot>restart</on_reboot>
    <on_crash>destroy</on_crash>
    <devices>
        <disk type='file' device='disk'>
            <driver name='qemu' type='qcow2' cache='none' io='native'/>
            <source file='/var/lib/libvirt/images/{{ controlNodes.hosts[0].vm_name }}.qcow2'/>
            <target dev='vda' bus='virtio'/>
        </disk>
        <disk type='file' device='cdrom'>
            <driver name='qemu' type='raw'/>
            <source file='/var/lib/libvirt/images/fcos-live.iso'/>
            <target dev='sda' bus='sata'/>
            <readonly/>
        </disk>
        <interface type='bridge'>
            <source bridge='{{ controlNodes.interface_bridge }}'/>
            <mac address='{{ controlNodes.hosts[0].vm_mac }}'/>
            <model type='virtio'/>
        </interface>
        <console type='pty'>
            <target type='serial' port='0'/>
        </console>
    </devices>
    <qemu:commandline>
        <qemu:arg value='-fw_cfg'/>
        <qemu:arg value='name=opt/com.coreos/config,file=/var/lib/libvirt/images/master.ign'/>
    </qemu:commandline>
</domain>
